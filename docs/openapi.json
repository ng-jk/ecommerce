{
  "openapi": "3.0.3",
  "info": {
    "title": "Commerce Portfolio API",
    "version": "1.0.0",
    "description": "All prices are integer MYR sen. Accounts and resources belong to one shop. Browser clients first GET /sanctum/csrf-cookie and send X-XSRF-TOKEN on writes. Native login/register supply device_name and use the returned Bearer token. Checkout keys are UUIDs reused on retries; first successful order wins."
  },
  "paths": {
    "/api/v1/shops/{shop}/products": {
      "get": {
        "operationId": "catalog",
        "parameters": [
          {
            "name": "shop",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "fashion",
                "electronics"
              ]
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Wrong shop or role"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
