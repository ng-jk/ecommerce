{
  "openapi": "3.0.3",
  "info": {
    "title": "Commerce Portfolio API",
    "version": "1.0.0",
    "description": "All prices are integer MYR sen. Accounts and resources belong to one shop. Browser clients first GET /sanctum/csrf-cookie and send X-XSRF-TOKEN on writes. Native login/register supply device_name and use the returned Bearer token. Checkout keys are UUIDs reused on retries; first successful order wins."
  },
