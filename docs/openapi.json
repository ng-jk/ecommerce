        "properties": {
          "id": {
            "type": "integer"
          },
          "shop_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "price": {
            "type": "integer"
          },
          "stock": {
            "type": "integer"
          },
          "active": {
            "type": "boolean"
          },
          "specifications": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "required": [
          "id",
          "shop_id",
          "name",
          "category",
          "description",
          "image_url",
          "price",
          "stock",
          "active",
          "specifications"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "shop_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "customer",
              "admin"
            ]
          }
        },
        "required": [
          "id",
          "shop_id",
          "name",
          "email",
          "role"
        ]
      },
      "Address": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "line1": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "enum": [
              "MY"
            ]
          }
        },
        "required": [
          "name",
          "line1",
          "city",
          "postcode",
          "country"
        ]
      },
      "CartInput": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "integer"
          },
          "quantity": {
            "type": "integer"
          }
        },
        "required": [
          "product_id",
          "quantity"
        ]
      },
      "CartLine": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "integer"
          },
          "quantity": {
            "type": "integer"
          },
          "product": {
            "$ref": "#/components/schemas/Product",
            "nullable": true
          }
        },
        "required": [
          "product_id",
          "quantity",
          "product"
        ]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "integer"
          },
          "quantity": {
            "type": "integer"
          }
        },
        "required": [
          "product_id",
          "name",
          "price",
          "quantity"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "shop_id": {
            "type": "integer"
          },
          "user_id": {
            "type": "integer"
          },
          "checkout_key": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "placed",
              "processing",
              "shipped",
              "completed"
            ]
          },
          "payment_method": {
            "type": "string",
            "enum": [
              "simulated"
            ]
          },
          "currency": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "shipping_address": {
            "$ref": "#/components/schemas/Address"
          },
          "subtotal": {
            "type": "integer"
          },
          "shipping": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "shop_id",
          "user_id",
          "checkout_key",
          "status",
          "payment_method",
          "currency",
          "items",
          "shipping_address",
          "subtotal",
          "shipping",
          "total",
          "created_at"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "message"
        ]
      },
      "ProductPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "current_page": {
            "type": "integer"
          },
          "last_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "data",
          "current_page",
          "last_page",
          "total"
        ]
      },
      "OrderPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "current_page": {
            "type": "integer"
          },
          "last_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "data",
          "current_page",
          "last_page",
          "total"
        ]
      },
      "Catalog": {
        "type": "object",
        "properties": {
          "shop": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "slug",
              "name"
            ]
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "products": {
            "$ref": "#/components/schemas/ProductPage"
          }
        },
        "required": [
          "shop",
          "categories",
          "products"
        ]
      },
      "Auth": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "user"
        ]
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "commerce_session"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
