{
  "get": {
    "operationId": "organizations",
    "parameters": [
      {
        "name": "shop",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 80
        }
      },
      {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      {
        "name": "per_page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      {
        "name": "status",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Indexed exact status filter; values and labels are supplied by the model options map."
      },
      {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "name": "X-Operation-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    ],
    "security": [
      {
        "cookieAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "responses": {
      "202": {
        "description": "Committed operation accepted; poll the private receipt for the business result.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../openapi.json#/components/schemas/Accepted"
            }
          }
        }
      },
      "401": {
        "description": "Authentication required"
      },
      "403": {
        "description": "Current account, organization or capability access denied"
      },
      "409": {
        "description": "Idempotency or version conflict"
      },
      "422": {
        "description": "validation_error field map"
      }
    },
    "description": "Framework organization workspace. Uses the current shop identity transport bridge; business authority is organization membership and is rechecked by the worker."
  },
  "post": {
    "operationId": "createOrganization",
