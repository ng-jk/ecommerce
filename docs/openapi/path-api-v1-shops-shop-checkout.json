{
  "post": {
    "operationId": "checkout",
    "parameters": [
      {
        "name": "shop",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "fashion",
            "electronics"
          ]
        }
      },
      {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "in": "header",
        "name": "X-Operation-Token",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    ],
    "security": [
      {
        "cookieAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "checkout_key": {
                "type": "string",
                "format": "uuid"
              },
              "shipping_address": {
                "$ref": "../openapi.json#/components/schemas/Address"
              },
              "expected_version": {
                "type": "integer",
                "minimum": 0
              },
              "payment_method": {
                "type": "string",
                "maxLength": 80,
                "description": "Optional configured payment method identifier or custom method name. Server configuration determines availability."
              }
            },
            "required": [
              "checkout_key",
              "shipping_address",
              "expected_version"
            ]
          }
        }
      }
    },
    "responses": {
      "401": {
        "description": "Unauthenticated"
      },
      "403": {
        "description": "Wrong shop or role"
      },
      "404": {
        "description": "Not found"
      },
      "422": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../openapi.json#/components/schemas/Error"
            }
          }
        }
      },
      "202": {
        "description": "Durably accepted. Poll the operation for its result.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../openapi.json#/components/schemas/Accepted"
            }
          }
        }
      }
    },
    "description": " Business execution is asynchronous; mutations of existing records require expected_version."
  }
}
