{
  "get": {
    "operationId": "standaloneLendingProducts",
    "description": "Standalone Lending workflow using explicit operator jurisdiction labels and whole-term flat charge terms, not APR. Approval requires a distinct decision maker and a valid first due date. No compliance, disbursement, repayment or account balance is asserted. Submitted terms are immutable; exact integer allocation conserves principal and charges.",
    "parameters": [
      {
        "name": "organization_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      {
        "name": "status",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "disabled"
          ]
        }
      },
      {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      {
        "name": "per_page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "name": "X-Operation-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    ],
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "responses": {
      "202": {
        "description": "Durable command accepted; poll its private result receipt"
      },
      "401": {
        "description": "Token unavailable or revoked"
      },
      "403": {
        "description": "Current membership, role or entitlement denied"
      },
      "404": {
        "description": "Record unavailable in this organization and visibility scope"
      },
      "409": {
        "description": "Version conflict"
      },
      "422": {
        "description": "Strict validation_error field map"
      },
      "504": {
        "description": "Remote Lending command deadline exceeded"
      }
    },
    "x-completed-result": {
      "description": "Versioned product/application with model-owned options, bounded data/meta page, or approved immutable schedule with integer principal_minor/charge_minor/total_minor and numbered due dates. Whole-term charge is rounded up once; each total is allocated by quotient and remainder."
    }
  },
  "post": {
    "operationId": "standaloneCreateLendingProduct",
    "description": "Standalone Lending workflow using explicit operator jurisdiction labels and whole-term flat charge terms, not APR. Approval requires a distinct decision maker and a valid first due date. No compliance, disbursement, repayment or account balance is asserted. Submitted terms are immutable; exact integer allocation conserves principal and charges.",
    "parameters": [
      {
        "name": "organization_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "name": "X-Operation-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    ],
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "responses": {
      "202": {
        "description": "Durable command accepted; poll its private result receipt"
      },
      "401": {
        "description": "Token unavailable or revoked"
      },
      "403": {
        "description": "Current membership, role or entitlement denied"
      },
      "404": {
        "description": "Record unavailable in this organization and visibility scope"
      },
      "409": {
        "description": "Version conflict"
      },
      "422": {
        "description": "Strict validation_error field map"
      },
      "504": {
        "description": "Remote Lending command deadline exceeded"
      }
    },
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "name",
              "jurisdiction_label",
              "terms_text",
              "currency",
              "minor_unit_digits",
              "principal_min_minor",
              "principal_max_minor",
              "term_rate_numerator",
              "term_rate_denominator",
              "installment_count",
              "interval_days"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,59}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "jurisdiction_label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "terms_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "minor_unit_digits": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "principal_min_minor": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000
              },
              "principal_max_minor": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000
              },
              "term_rate_numerator": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "term_rate_denominator": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "installment_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120
              },
              "interval_days": {
                "type": "integer",
                "minimum": 1,
                "maximum": 365
              }
            }
          }
        }
      }
    },
    "x-completed-result": {
      "description": "Versioned product/application with model-owned options, bounded data/meta page, or approved immutable schedule with integer principal_minor/charge_minor/total_minor and numbered due dates. Whole-term charge is rounded up once; each total is allocated by quotient and remainder."
    }
  }
}
