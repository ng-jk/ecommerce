{
  "get": {
    "operationId": "erpAccount",
    "description": "View one organization chart account.",
    "parameters": [
      {
        "name": "organization_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "name": "X-Operation-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    ],
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "responses": {
      "202": {
        "description": "Committed ERP operation; poll its private receipt.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../openapi.json#/components/schemas/Accepted"
            }
          }
        }
      },
      "401": {
        "description": "Authentication required"
      },
      "403": {
        "description": "Current membership or ERP entitlement denied"
      },
      "404": {
        "description": "ERP record unavailable in this organization"
      },
      "409": {
        "description": "Version or journal workflow conflict"
      },
      "422": {
        "description": "validation_error field map"
      },
      "504": {
        "description": "Remote ERP command deadline exceeded"
      }
    },
    "x-completed-result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "code": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "enum": [
                "asset",
                "liability",
                "equity",
                "revenue",
                "expense"
              ]
            },
            "version": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "id",
            "code",
            "name",
            "type",
            "version"
          ]
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "type"
          ]
        }
      },
      "required": [
        "account",
        "options"
      ]
    }
  },
