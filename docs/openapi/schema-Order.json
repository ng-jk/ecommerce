{
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "shop_id": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "placed",
        "processing",
        "shipped",
        "completed"
      ]
    },
    "payment_method": {
      "type": "string",
      "maxLength": 80,
      "description": "Configured provider identifier such as stripe, billplz, simulated, or a custom method name."
    },
    "currency": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "../openapi.json#/components/schemas/OrderItem"
      }
    },
    "shipping_address": {
      "$ref": "../openapi.json#/components/schemas/Address"
    },
    "subtotal": {
      "type": "integer"
    },
    "shipping": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    },
    "created_at": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "payment_label": {
      "type": "string"
    },
    "can_fulfill": {
      "type": "boolean"
    },
    "payment": {
      "type": "object",
      "properties": {
        "public_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "creating",
            "pending",
            "review",
            "paid",
            "cancelled"
          ]
        },
        "label": {
          "type": "string"
        },
        "invoice_id": {
          "type": "string",
          "format": "uuid"
        },
        "provider": {
          "type": "string",
          "enum": [
            "billplz",
            "stripe",
            "custom"
          ]
        },
        "checkout_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?:(?:www\\.)?billplz\\.com/.*|checkout\\.stripe\\.com/c/pay/.*)$",
          "description": "Billplz hosted payment URL or Stripe Checkout URL at https://checkout.stripe.com/c/pay/.",
          "nullable": true
        },
        "paid_at": {
          "type": "string",
          "nullable": true
        }
      },
      "required": [
        "public_id",
        "status",
        "label",
        "checkout_url",
        "paid_at"
      ],
      "nullable": true
    }
  },
  "required": [
    "id",
    "shop_id",
    "status",
    "payment_method",
    "currency",
    "items",
    "shipping_address",
    "subtotal",
    "shipping",
    "total",
    "created_at",
    "version"
  ]
}
