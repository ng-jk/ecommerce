{
  "get": {
    "operationId": "solutionPurchases",
    "parameters": [
      {
        "name": "shop",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 80
        }
      },
      {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      {
        "name": "per_page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "name": "X-Operation-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    ],
    "responses": {
      "202": {
        "description": "Durably accepted; poll the private operation receipt.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../openapi.json#/components/schemas/Accepted"
            }
          }
        }
      },
      "401": {
        "description": "Authentication required"
      },
      "403": {
        "description": "Current shop or organization authority denied"
      },
      "404": {
        "description": "Resource unavailable"
      },
      "409": {
        "description": "Idempotency or state conflict"
      },
      "422": {
        "description": "validation_error field map"
      }
    },
    "description": "Durable worker command; payment authority is verified by the payment worker.",
    "security": [
      {
        "cookieAuth": []
      },
      {
        "bearerAuth": []
      }
    ]
  },
  "post": {
    "operationId": "bindSolutionPurchase",
    "parameters": [
      {
        "name": "shop",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 80
        }
      },
      {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "name": "X-Operation-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    ],
    "responses": {
      "202": {
        "description": "Durably accepted; poll the private operation receipt.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../openapi.json#/components/schemas/Accepted"
            }
          }
        }
      },
      "401": {
        "description": "Authentication required"
      },
      "403": {
        "description": "Current shop or organization authority denied"
      },
      "404": {
        "description": "Resource unavailable"
      },
      "409": {
        "description": "Idempotency or state conflict"
      },
      "422": {
        "description": "validation_error field map"
      }
    },
    "description": "Bind an order owned by this shop user to an organization they own. Checkout pins the exact immutable offering version on the order; only a verified provider settlement grants access.",
    "security": [
      {
        "cookieAuth": []
      },
      {
        "bearerAuth": []
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "offering_id": {
                "type": "integer",
                "minimum": 1
              },
              "order_id": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "offering_id",
              "order_id"
            ],
            "additionalProperties": false
          }
        }
      }
    }
