{
  "get": {
    "operationId": "crmActivity",
    "parameters": [
      {
        "name": "organization_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "name": "X-Operation-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    ],
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "responses": {
      "202": {
        "description": "Committed CRM operation; poll its private receipt.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../openapi.json#/components/schemas/Accepted"
            }
          }
        }
      },
      "401": {
        "description": "Authentication required"
      },
      "403": {
        "description": "Current organization membership or CRM entitlement denied"
      },
      "404": {
        "description": "CRM record unavailable in this organization"
      },
      "409": {
        "description": "Version or workflow conflict"
      },
      "422": {
        "description": "validation_error field map"
      },
      "504": {
        "description": "Remote CRM command deadline exceeded"
      }
    },
    "description": "Standalone CRM command. Platform identity, membership, installation, entitlement, and any assignee target are checked before the isolated CRM effect.",
    "x-completed-result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity",
        "options"
      ],
      "properties": {
        "activity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "deal_id",
            "type",
            "summary",
            "occurred_at"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "deal_id": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "type": "string",
              "maxLength": 24
            },
            "summary": {
              "type": "string",
              "maxLength": 500
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
