{
  "post": {
    "operationId": "platformAssistant",
    "parameters": [
      {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "in": "header",
        "name": "X-Operation-Token",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "message": {
                "type": "string",
                "maxLength": 2000
              },
              "action": {
                "type": "string"
              },
              "data": {
                "type": "object",
                "additionalProperties": true
              },
              "conversation_id": {
                "type": "string",
                "format": "uuid"
              },
              "conversation_version": {
                "type": "integer",
                "minimum": 0
              },
              "confirm": {
                "type": "boolean"
              },
              "discover": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "responses": {
      "401": {
        "description": "Unauthenticated"
      },
      "403": {
        "description": "Wrong shop or role"
      },
      "404": {
        "description": "Not found"
      },
      "422": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../openapi.json#/components/schemas/Error"
            }
          }
        }
      },
      "202": {
        "description": "Durably accepted. Poll the operation for its result.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../openapi.json#/components/schemas/Accepted"
            }
          }
        }
      }
    },
    "description": "Shop-independent assistant; Laravel AI SDK proposes capabilities only. Current identity, membership, application and command guards remain authoritative. Natural-language proposals and mutations require explicit confirmation.",
    "security": [
      {
        "bearerAuth": []
      }
    ]
  }
}
