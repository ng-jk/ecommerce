{
  "get": {
    "operationId": "standaloneApplicationCatalog",
    "description": "Paginated trusted application definitions with current organization installation and entitlement state. Availability does not grant payment or install authority.",
    "parameters": [
      { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 1000000 } },
      { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50 } },
      { "name": "application_key", "in": "query", "schema": { "type": "string", "maxLength": 80 } },
      { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
      { "name": "X-Operation-Token", "in": "header", "required": true, "schema": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    ],
    "security": [{ "bearerAuth": [] }],
    "responses": {
      "202": { "description": "Committed operation accepted; poll the private receipt for catalog data, pagination, and can_manage." },
      "401": { "description": "Authentication required" },
      "403": { "description": "Current account or Framework entitlement access denied" },
      "422": { "description": "validation_error field map" }
    }
  }
}
