{
  "post": {
    "operationId": "assistant",
    "parameters": [
      {
        "name": "shop",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "fashion",
            "electronics"
          ]
        }
      },
      {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "in": "header",
        "name": "X-Operation-Token",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "message": {
                "type": "string",
                "maxLength": 2000
              },
              "action": {
                "type": "string"
              },
              "data": {
                "type": "object",
                "additionalProperties": true
              },
              "conversation_id": {
                "type": "string",
                "format": "uuid"
              },
              "conversation_version": {
                "type": "integer",
                "minimum": 0
              },
              "confirm": {
                "type": "boolean"
              },
              "discover": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "responses": {
      "401": {
        "description": "Unauthenticated"
      },
      "403": {
        "description": "Wrong shop or role"
      },
      "404": {
        "description": "Not found"
      },
      "422": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../openapi.json#/components/schemas/Error"
            }
          }
        }
      },
      "202": {
        "description": "Durably accepted. Poll the operation for its result.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../openapi.json#/components/schemas/Accepted"
            }
          }
        }
      }
    },
    "description": "Natural-language action selection, collection and execution. Durable 202 response; poll using X-Operation-Token. Reuse the same receipt across conversation turns, new idempotency key per turn. Every write requires a separate confirm:true turn and the returned conversation_version. discover:true returns caller-authorized tools. Credentials must be supplied as data, not message. Infrastructure operations are registered but cannot be model-invoked. Natural-language reads also require confirmation. Discovery includes role, effective allowed_roles and natural_language_confirmation_required. Configuration in backend/config/commerce.php restricts REST and AI execution; disabling a tool invalidates pending confirmation."
  }
}
