{
  "get": {
    "operationId": "erpLedger",
    "description": "List posted ledger lines for one scoped chart account.",
    "parameters": [
      {
        "name": "organization_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      {
        "name": "per_page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      {
        "name": "account_id",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "name": "X-Operation-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    ],
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "responses": {
      "202": {
        "description": "Committed ERP operation; poll its private receipt.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../openapi.json#/components/schemas/Accepted"
            }
          }
        }
      },
      "401": {
        "description": "Authentication required"
      },
      "403": {
        "description": "Current membership or ERP entitlement denied"
      },
      "404": {
        "description": "ERP record unavailable in this organization"
      },
      "409": {
        "description": "Version or journal workflow conflict"
      },
      "422": {
        "description": "validation_error field map"
      },
      "504": {
        "description": "Remote ERP command deadline exceeded"
      }
    },
    "x-completed-result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "journal_id": {
                "type": "integer",
                "minimum": 1
              },
              "account_id": {
                "type": "integer",
                "minimum": 1
              },
              "debit_minor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9000000000000000
              },
              "credit_minor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9000000000000000
              }
            },
            "required": [
              "id",
              "journal_id",
              "account_id",
              "debit_minor",
              "credit_minor"
            ]
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "current_page": {
              "type": "integer",
              "minimum": 1
            },
            "per_page": {
              "type": "integer",
              "minimum": 1
            },
            "last_page": {
              "type": "integer",
              "minimum": 1
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "current_page",
            "per_page",
            "last_page",
            "total"
          ]
        }
      },
      "required": [
        "data",
        "meta"
      ]
    }
