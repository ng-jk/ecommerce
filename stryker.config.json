{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.mts"
  },
  "mutate": [
    "packages/api-client/data/**/*.ts",
    "packages/storefront/domain/**/*.ts",
    "frontend/admin/src/domain/**/*.ts"
  ],
  "reporters": [
    "clear-text",
    "json",
    "html"
  ],
  "concurrency": 2,
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "ignorePatterns": [
    "/backend",
    "/.venv",
    "/.tools",
    "/formal/.lake",
    "/test-results",
    "/coverage",
    "**/dist",
    "**/dist-native",
    "**/.expo",
    "**/.env",
    "/.env",
    "/.scaffold",
    "/.pytest_cache",
    "/.hypothesis"
  ]
}
