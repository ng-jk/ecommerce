APP_KEY=
DB_PASSWORD=
COMPOSE_PARALLEL_LIMIT=1
FASHION_HOST=fashion.example.com
ELECTRONICS_HOST=electronics.example.com
ADMIN_HOST=admin.example.com
API_HOST=api.example.com
TLS_EMAIL=you@example.com
HF_TOKEN=

# Billplz DuitNow QR: enable only after merchant onboarding and sandbox verification.
PAYMENT_DRIVER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_URL=
STRIPE_SANDBOX=true
BILLPLZ_SANDBOX=true
BILLPLZ_API_KEY=
BILLPLZ_SIGNATURE_KEY=
BILLPLZ_FASHION_COLLECTION_ID=
BILLPLZ_ELECTRONICS_COLLECTION_ID=
PAYMENT_WEBHOOK_BASE_URL=
BILLPLZ_FASHION_RETURN_URL=
BILLPLZ_ELECTRONICS_RETURN_URL=

# Static Mini Apps require a dedicated origin. Never use a storefront/API origin.
MINIAPP_ASSET_ORIGIN=http://miniapps.localhost:8080
MINIAPP_PARENT_ORIGINS=http://fashion.localhost:8080,http://electronics.localhost:8080,http://admin.localhost:8080
EXPO_PUBLIC_MINIAPP_ASSET_ORIGIN=http://miniapps.localhost:8080
# Privileged operator audit identities; empty denies approval/revocation.
MINIAPP_APPROVER_USER_IDS=
