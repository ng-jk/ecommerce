{
  "name": "ecommerce-portfolio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend/*",
    "packages/*"
  ],
  "scripts": {
    "dev:fashion": "npm run start -w @portfolio/fashion",
    "dev:electronics": "npm run start -w @portfolio/electronics",
    "dev:admin": "npm run web -w @portfolio/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "export:web": "npm run export:web --workspaces --if-present",
    "api:types": "node scripts/generate-api.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint frontend packages",
    "architecture": "depcruise --config .dependency-cruiser.cjs --output-type err-long frontend packages"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.4.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "fast-check": "4.10.2",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.9.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shell-quote": "1.12.0",
    "typed-rest-client": {
      "qs": "6.16.0"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
