{
  "name": "ecommerce-portfolio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend/*",
    "packages/*"
  ],
  "scripts": {
    "dev:fashion": "npm run start -w @portfolio/fashion",
    "dev:electronics": "npm run start -w @portfolio/electronics",
    "dev:admin": "npm run web -w @portfolio/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "export:web": "npm run export:web --workspaces --if-present",
    "api:types": "openapi-typescript docs/openapi.json -o packages/api-client/schema.d.ts",
    "test:e2e": "playwright test",
    "lint": "eslint frontend packages"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.9.8"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
