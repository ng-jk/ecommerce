{
    auto_https off
    admin off
}
https://platform-internal {
    tls /certificates/services.crt /certificates/services.key
    @service path /api/v1/internal/services/inbox /api/v1/internal/services/authorize
    handle @service {
        root * /var/www/html/public
        php_fastcgi backend:9000
    }
    handle {
        respond "Not found" 404
    }
}
https://crm-internal {
    tls /certificates/services.crt /certificates/services.key
    @service path /api/v1/internal/services/inbox /api/v1/internal/services/result-authority
