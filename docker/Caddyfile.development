{
    auto_https off
}
(api) {
    handle_path /storage/* {
        root * /srv/uploads
        file_server
    }
    @backend path /api/* /sanctum/* /up /miniapp-assets/*
    handle @backend {
        root * /var/www/html/public
        php_fastcgi backend:9000
        file_server
    }
}
http://miniapps.localhost:8080 {
    @assets path /miniapp-assets/*
    handle @assets {
        root * /var/www/html/public
        php_fastcgi backend:9000 {
            try_files /index.php
        }
    }
    handle {
        respond "Not found" 404
    }
}
http://fashion.localhost:8080 {
    import api
    handle {
        reverse_proxy fashion:8081
    }
}
http://electronics.localhost:8080 {
    import api
    handle {
        reverse_proxy electronics:8082
    }
}
http://admin.localhost:8080 {
    import api
    handle {
        reverse_proxy admin:8083
    }
}
http://:8080 {
    import api
    handle {
        respond "Commerce API"
    }
}
